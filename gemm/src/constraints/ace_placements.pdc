
# -------------------------------------------------------------------------
# ACE placements file
# This defines the physical placement of instances on the die
# Primarily the IO locations, however instance locations and placement
# regions can also be defined here
# -------------------------------------------------------------------------

# -------------------------------------------------------------------------
# Place NAPs
# IMPORTANT - if a location is changed here, then also change it in the testbench
# Also - ensure NAP locations here match PCIe DMA targets, (BRAM responder)
# and PCIe BAR registers (reg_control)
# -------------------------------------------------------------------------

# Reg control NAP to 5,5
set_placement -fixed {i:i_reg_control_block.i_axi_initiator.i_axi_initiator} {s:x_core.NOC[5][5].logic.noc.nap_m}
# Optional Reg control DMA accelerator to 5,5
if { [find *gb_dma_accel*i_axi_responder* -insts] != "" } {
    set_placement -fixed {i:i_reg_control_block.gb_dma_accel.i_dma_accel.i_axi_responder.i_axi_responder} {s:x_core.NOC[5][5].logic.noc.nap_s}
}

# BRAM responder - For ATU Demonstration
set_placement -fixed {i:i_axi_bram_rsp_atu.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[7][7].logic.noc.nap_m}

# -------------------------------------------------------------------------
# DMA BRAM NAP Placements
# -------------------------------------------------------------------------
# DESIGN RATIONALE:
#   DMA BRAMs are placed at column 7 to avoid routing congestion with:
#   1. ADM (Achronix Device Manager) paths - ADM uses center columns for PCIe
#   2. Reg control NAP at NOC[5][5] - requires clear path to PCIe endpoint
#   3. GDDR NAPs at columns 1 and 10 - avoids NoC traffic conflicts
#
# REFERENCES:
#   1. Speedster7t 2D NoC User Guide (UG089), "NAP Placement Guidelines":
#      "Avoid placing user NAPs in columns 4-6 which may conflict with
#       device manager and PCIe interface paths."
#   2. GDDR6 Reference Design Guide (RD017), "NAP Locations":
#      "NAPs should be placed adjacent to target subsystems for minimum latency"
#
# NOTE: Internal BRAM write/read signals do NOT traverse NoC - they use
#       fabric routing. NAP location primarily affects DMA access latency.
# -------------------------------------------------------------------------

# DMA Data Out BRAM - Result buffer for host DMA read-back
# Placement: NOC[7][5] - column 7 avoids ADM congestion, row 5 is central
set_placement -fixed {i:i_dma_data_out_bram.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[7][5].logic.noc.nap_m}

# DMA Command In BRAM - Command buffer for host DMA write, engine read
# Placement: NOC[7][6] - adjacent to data out BRAM for minimal fabric distance
set_placement -fixed {i:i_dma_cmd_in_bram.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[7][6].logic.noc.nap_m}

# BRAM responder - Descriptor lists
set_placement -fixed {i:i_axi_bram_rsp_dl.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[9][7].logic.noc.nap_m}

# MSIX Interrupt Handler
set_placement -fixed {i:i_msix_irq_handler.i_axi_responder_nap.i_axi_responder} {s:x_core.NOC[5][7].logic.noc.nap_s}

# FLR Responder
set_placement -fixed {i:i_flr_responder.i_axi_responder_nap.i_axi_responder} {s:x_core.NOC[9][8].logic.noc.nap_s}

# -------------------------------------------------------------------------
# GDDR6 NAP Placements - 2D Multi-Row GEMM Engine (16 NAPs)
# -------------------------------------------------------------------------
# 16 NAP responders, one per GDDR6 channel (16 rows -> 16 channels)
#
# OPTIMIZATION RATIONALE:
#   NAPs placed at columns CLOSEST to their target GDDR controllers for
#   minimum latency. NoC transactions travel east/west along rows - shorter
#   distance = lower latency.
#
#   - West side (Rows 0-7):  NOC column 1 -> closest to west-edge GDDR0-3
#   - East side (Rows 8-15): NOC column 10 -> closest to east-edge GDDR4-7
#
# REFERENCES:
#   1. Speedster7t GDDR6 Reference Design Guide (RD017), "NAP Locations":
#      "The NAP locations should be chosen to be adjacent to the target
#       GDDR6 subsystem on the east or west side of the FPGA depending on
#       which side is closest to the target GDDR6 subsystem."
#
#   2. GDDR6_NAP_GUIDE.md, Section "Physical Layout":
#      "Columns 1-5: West side of device (closer to GDDR0-3)"
#      "Columns 6-10: East side of device (closer to GDDR4-7)"
#
#   3. acx_gemm_ref_design (ace_placements.pdc.4q):
#      Uses columns 1,2,4,5 for west quadrants, columns 6,7,9,10 for east
#
# CONSTRAINT: NoC rows 9-10 do NOT exist on AC7t1500 - valid range is 1-8
#
# MUST MATCH: elastix_gemm_top.sv NAP_COL/NAP_ROW arrays (lines 509-523)
# -------------------------------------------------------------------------

# West side NAPs (rows 0-7) on NOC column 1 (closest to GDDR0-3)
# Row 0: GDDR0 Ch0 (Control ID 0xC) - NOC[1][1]
set_placement -fixed [find -insts "gen_gddr_nap_0__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][1].logic.noc.nap_s"

# Row 1: GDDR0 Ch1 (Control ID 0xD) - NOC[1][2]
set_placement -fixed [find -insts "gen_gddr_nap_1__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][2].logic.noc.nap_s"

# Row 2: GDDR1 Ch0 (Control ID 0x4) - NOC[1][3]
set_placement -fixed [find -insts "gen_gddr_nap_2__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][3].logic.noc.nap_s"

# Row 3: GDDR1 Ch1 (Control ID 0x5) - NOC[1][4]
set_placement -fixed [find -insts "gen_gddr_nap_3__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][4].logic.noc.nap_s"

# Row 4: GDDR2 Ch0 (Control ID 0x0) - NOC[1][5]
set_placement -fixed [find -insts "gen_gddr_nap_4__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][5].logic.noc.nap_s"

# Row 5: GDDR2 Ch1 (Control ID 0x1) - NOC[1][6]
set_placement -fixed [find -insts "gen_gddr_nap_5__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][6].logic.noc.nap_s"

# Row 6: GDDR3 Ch0 (Control ID 0x8) - NOC[1][7]
set_placement -fixed [find -insts "gen_gddr_nap_6__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][7].logic.noc.nap_s"

# Row 7: GDDR3 Ch1 (Control ID 0x9) - NOC[1][8]
set_placement -fixed [find -insts "gen_gddr_nap_7__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[1][8].logic.noc.nap_s"

# East side NAPs (rows 8-15) on NOC column 10 (closest to GDDR4-7)
# Row 8: GDDR4 Ch0 (Control ID 0xF) - NOC[10][1]
set_placement -fixed [find -insts "gen_gddr_nap_8__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][1].logic.noc.nap_s"

# Row 9: GDDR4 Ch1 (Control ID 0xE) - NOC[10][2]
set_placement -fixed [find -insts "gen_gddr_nap_9__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][2].logic.noc.nap_s"

# Row 10: GDDR5 Ch0 (Control ID 0x7) - NOC[10][3]
set_placement -fixed [find -insts "gen_gddr_nap_10__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][3].logic.noc.nap_s"

# Row 11: GDDR5 Ch1 (Control ID 0x6) - NOC[10][4]
set_placement -fixed [find -insts "gen_gddr_nap_11__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][4].logic.noc.nap_s"

# Row 12: GDDR6 Ch0 (Control ID 0x3) - NOC[10][5]
set_placement -fixed [find -insts "gen_gddr_nap_12__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][5].logic.noc.nap_s"

# Row 13: GDDR6 Ch1 (Control ID 0x2) - NOC[10][6]
set_placement -fixed [find -insts "gen_gddr_nap_13__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][6].logic.noc.nap_s"

# Row 14: GDDR7 Ch0 (Control ID 0xB) - NOC[10][7]
set_placement -fixed [find -insts "gen_gddr_nap_14__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][7].logic.noc.nap_s"

# Row 15: GDDR7 Ch1 (Control ID 0xA) - NOC[10][8]
set_placement -fixed [find -insts "gen_gddr_nap_15__*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[10][8].logic.noc.nap_s"

# -------------------------------------------------------------------------
# 2D GEMM Engine Soft Placement Regions
# -------------------------------------------------------------------------
# These soft regions guide placement of non-MLP/BRAM logic (FSMs, FIFOs, etc.)
# near their associated compute rows. Coordinates are fabric cluster units.
#
# NOTE: MLP/BRAM have fixed placements below that override these soft regions.
# -------------------------------------------------------------------------

# West side region for rows 0-7 (near NAPs at column 1)
create_region "region_gemm_engine_west" "20 160 60 260" -snap fabric_clusters -type soft
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_0*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_1*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_2*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_3*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_4*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_5*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_6*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_7*"

# East side region for rows 8-15 (near NAPs at column 10)
create_region "region_gemm_engine_east" "320 160 360 260" -snap fabric_clusters -type soft
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_8*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_9*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_10*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_11*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_12*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_13*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_14*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_15*"

# -------------------------------------------------------------------------
# MLP and BRAM Placement for 2D GEMM Engine
# -------------------------------------------------------------------------
# CURRENT CONFIGURATION: NUM_MLPS=2, NUM_STACKS=4, NUM_ROWS=16
#   Total MLPs per row: NUM_MLPS * NUM_STACKS = 2 * 4 = 8 MLPs
#   Total MLPs: 16 rows * 8 MLPs/row = 128 MLPs
#   Total BRAMs: 128 (one per MLP for weight storage)
#
# EXPLICIT PLACEMENTS: 64 MLPs + 64 BRAMs (first MLP/BRAM per stack)
#   Remaining MLPs/BRAMs cascade automatically from mlp_col_base placement
#
# INSTANCE HIERARCHY (from comp_MLPRow.sv):
#   i_engine_top_2d.gen_row_R__*u_compute_engine.u_mlp_stack.gen_mlp_stack_S__*u_mlp_row.
#     mlp_col_base.u_mlp_dot16_bfp8.i_MLP          (ACX_MLP72 - first, explicitly placed)
#     mlp_col_base.u_weight_bram.u_acx_bram72k     (ACX_BRAM72K - first, explicitly placed)
#     mlp_gen[1].mlp_col_stack.u_mlp_dot16_bfp8.i_MLP   (cascaded, auto-placed)
#     mlp_gen[1].mlp_col_stack.u_weight_bram.u_acx_bram72k (cascaded, auto-placed)
#
# PLACEMENT STRATEGY:
#   - West rows (0-7): BMLP x = 0-3, near NAPs at NOC column 1
#   - East rows (8-15): BMLP x = 35-38, near NAPs at NOC column 10
#   - Y coordinate: row * 4 (west) or (row-8) * 4 (east)
#
# REFERENCES:
#   1. Speedster7t Component Library UG086-1, Section "ACX_MLP72":
#      "MLP primitives cascade horizontally when placed adjacently"
#   2. Speedster7t Component Library UG086-1, Section "ACX_BRAM72K":
#      "BRAM should be co-located with MLP at same BMLP block for minimal routing"
#   3. GDDR6 Reference Design Guide (RD017), "NAP Locations":
#      "Place compute logic near NAPs for minimum NoC latency"
#
# CO-LOCATION PRINCIPLE:
#   Each MLP and its weight BRAM share the same BMLP block coordinate.
#   This ensures single-cycle BRAM-to-MLP data transfer without fabric routing.
# -------------------------------------------------------------------------

# West side rows (0-7): NAPs at NOC column 1
# Each row's 4 stacks placed at BMLP x=0,1,2,3 (west edge, near column 1 NAPs)
for {set row 0} {$row < 8} {incr row} {
    set bmlp_y [expr {$row * 4}]
    for {set stack 0} {$stack < 4} {incr stack} {
        set bmlp_x $stack
        
        # Find and place the first MLP (mlp_col_base) of this stack
        set mlp_pattern "i_engine_top_2d.gen_row_${row}__*u_compute_engine.u_mlp_stack.gen_mlp_stack_${stack}__*u_mlp_row.mlp_col_base.u_mlp_dot16_bfp8.i_MLP"
        set mlp_inst [find -insts $mlp_pattern]
        if { $mlp_inst != "" } {
            set_placement -fixed $mlp_inst "s:x_core.BMLP\[${bmlp_x}\]\[${bmlp_y}\].logic.bmlp.mlp\[0\]"
        }
        
        # Find and place the BRAM co-located with MLP (same BMLP block)
        set bram_pattern "i_engine_top_2d.gen_row_${row}__*u_compute_engine.u_mlp_stack.gen_mlp_stack_${stack}__*u_mlp_row.mlp_col_base.u_weight_bram.u_acx_bram72k"
        set bram_inst [find -insts $bram_pattern]
        if { $bram_inst != "" } {
            set_placement -fixed $bram_inst "s:x_core.BMLP\[${bmlp_x}\]\[${bmlp_y}\].logic.bmlp.bram\[0\]"
        }
    }
}

# East side rows (8-15): NAPs at NOC column 10
# Each row's 4 stacks placed at BMLP x=35,36,37,38 (east edge, near column 10 NAPs)
for {set row 8} {$row < 16} {incr row} {
    set bmlp_y [expr {($row - 8) * 4}]
    for {set stack 0} {$stack < 4} {incr stack} {
        set bmlp_x [expr {35 + $stack}]
        
        # Find and place the first MLP (mlp_col_base) of this stack
        set mlp_pattern "i_engine_top_2d.gen_row_${row}__*u_compute_engine.u_mlp_stack.gen_mlp_stack_${stack}__*u_mlp_row.mlp_col_base.u_mlp_dot16_bfp8.i_MLP"
        set mlp_inst [find -insts $mlp_pattern]
        if { $mlp_inst != "" } {
            set_placement -fixed $mlp_inst "s:x_core.BMLP\[${bmlp_x}\]\[${bmlp_y}\].logic.bmlp.mlp\[0\]"
        }
        
        # Find and place the BRAM co-located with MLP (same BMLP block)
        set bram_pattern "i_engine_top_2d.gen_row_${row}__*u_compute_engine.u_mlp_stack.gen_mlp_stack_${stack}__*u_mlp_row.mlp_col_base.u_weight_bram.u_acx_bram72k"
        set bram_inst [find -insts $bram_pattern]
        if { $bram_inst != "" } {
            set_placement -fixed $bram_inst "s:x_core.BMLP\[${bmlp_x}\]\[${bmlp_y}\].logic.bmlp.bram\[0\]"
        }
    }
}



