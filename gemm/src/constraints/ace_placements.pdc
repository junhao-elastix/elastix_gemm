
# -------------------------------------------------------------------------
# ACE placements file
# This defines the physical placement of instances on the die
# Primarily the IO locations, however instance locations and placement
# regions can also be defined here
# -------------------------------------------------------------------------

# -------------------------------------------------------------------------
# Place NAPs
# IMPORTANT - if a location is changed here, then also change it in the testbench
# Also - ensure NAP locations here match PCIe DMA targets, (BRAM responder)
# and PCIe BAR registers (reg_control)
# -------------------------------------------------------------------------

# Reg control NAP to 5,5
set_placement -fixed {i:i_reg_control_block.i_axi_initiator.i_axi_initiator} {s:x_core.NOC[5][5].logic.noc.nap_m}
# Optional Reg control DMA accelerator to 5,5
if { [find *gb_dma_accel*i_axi_responder* -insts] != "" } {
    set_placement -fixed {i:i_reg_control_block.gb_dma_accel.i_dma_accel.i_axi_responder.i_axi_responder} {s:x_core.NOC[5][5].logic.noc.nap_s}
}

# BRAM responder - For ATU Demonstration
set_placement -fixed {i:i_axi_bram_rsp_atu.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[7][7].logic.noc.nap_m}

# BRAM responder - DMA (Result Data) - CO-LOCATED with MS2.0 engine (Oct 10, 2025 NAP fix)
# CRITICAL: Must be near engine at NOC[3][4] for internal write ports to work
# Internal BRAM write signals cannot cross NoC fabric - requires physical proximity
set_placement -fixed {i:i_axi_bram_rsp_dma.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[3][5].logic.noc.nap_m}

# BRAM responder - Descriptor lists
set_placement -fixed {i:i_axi_bram_rsp_dl.i_axi_initiator_nap.i_axi_initiator} {s:x_core.NOC[9][7].logic.noc.nap_m}

# MSIX Interrupt Handler
set_placement -fixed {i:i_msix_irq_handler.i_axi_responder_nap.i_axi_responder} {s:x_core.NOC[5][7].logic.noc.nap_s}

# FLR Responder
set_placement -fixed {i:i_flr_responder.i_axi_responder_nap.i_axi_responder} {s:x_core.NOC[9][8].logic.noc.nap_s}

# -------------------------------------------------------------------------
# GDDR6 NAP Placements - 2D Multi-Row GEMM Engine (16 NAPs)
# 16 NAP responders, one per GDDR6 channel (16 rows -> 16 channels)
# -------------------------------------------------------------------------
# Placement Mapping:
#   West side (Rows 0-7):  NOC column 3, rows 3-10
#   East side (Rows 8-15): NOC column 8, rows 3-10
# -------------------------------------------------------------------------

# West side NAPs (rows 0-7) on NOC column 3
# Row 0: Controller 0 Ch0 (PAGE_ID 0xC) - NOC[3][3]
set_placement -fixed [find -insts "gen_gddr_nap_0\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][3].logic.noc.nap_s"

# Row 1: Controller 0 Ch1 (PAGE_ID 0xD) - NOC[3][4]
set_placement -fixed [find -insts "gen_gddr_nap_1\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][4].logic.noc.nap_s"

# Row 2: Controller 1 Ch0 (PAGE_ID 0x4) - NOC[3][5]
set_placement -fixed [find -insts "gen_gddr_nap_2\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][5].logic.noc.nap_s"

# Row 3: Controller 1 Ch1 (PAGE_ID 0x5) - NOC[3][6]
set_placement -fixed [find -insts "gen_gddr_nap_3\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][6].logic.noc.nap_s"

# Row 4: Controller 2 Ch0 (PAGE_ID 0x0) - NOC[3][7]
set_placement -fixed [find -insts "gen_gddr_nap_4\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][7].logic.noc.nap_s"

# Row 5: Controller 2 Ch1 (PAGE_ID 0x1) - NOC[3][8]
set_placement -fixed [find -insts "gen_gddr_nap_5\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][8].logic.noc.nap_s"

# Row 6: Controller 3 Ch0 (PAGE_ID 0x8) - NOC[3][9]
set_placement -fixed [find -insts "gen_gddr_nap_6\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][9].logic.noc.nap_s"

# Row 7: Controller 3 Ch1 (PAGE_ID 0x9) - NOC[3][10]
set_placement -fixed [find -insts "gen_gddr_nap_7\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[3][10].logic.noc.nap_s"

# East side NAPs (rows 8-15) on NOC column 8
# Row 8: Controller 4 Ch0 (PAGE_ID 0xF) - NOC[8][3]
set_placement -fixed [find -insts "gen_gddr_nap_8\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][3].logic.noc.nap_s"

# Row 9: Controller 4 Ch1 (PAGE_ID 0xE) - NOC[8][4]
set_placement -fixed [find -insts "gen_gddr_nap_9\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][4].logic.noc.nap_s"

# Row 10: Controller 5 Ch0 (PAGE_ID 0x7) - NOC[8][5]
set_placement -fixed [find -insts "gen_gddr_nap_10\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][5].logic.noc.nap_s"

# Row 11: Controller 5 Ch1 (PAGE_ID 0x6) - NOC[8][6]
set_placement -fixed [find -insts "gen_gddr_nap_11\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][6].logic.noc.nap_s"

# Row 12: Controller 6 Ch0 (PAGE_ID 0x3) - NOC[8][7]
set_placement -fixed [find -insts "gen_gddr_nap_12\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][7].logic.noc.nap_s"

# Row 13: Controller 6 Ch1 (PAGE_ID 0x2) - NOC[8][8]
set_placement -fixed [find -insts "gen_gddr_nap_13\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][8].logic.noc.nap_s"

# Row 14: Controller 7 Ch0 (PAGE_ID 0xB) - NOC[8][9]
set_placement -fixed [find -insts "gen_gddr_nap_14\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][9].logic.noc.nap_s"

# Row 15: Controller 7 Ch1 (PAGE_ID 0xA) - NOC[8][10]
set_placement -fixed [find -insts "gen_gddr_nap_15\*i_nap_responder.i_axi_responder"] \
    "s:x_core.NOC[8][10].logic.noc.nap_s"

# -------------------------------------------------------------------------
# 2D GEMM Engine Placement Regions
# -------------------------------------------------------------------------
# West side region for rows 0-7
create_region "region_gemm_engine_west" "55 160 81 260" -snap fabric_clusters -type soft
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_0*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_1*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_2*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_3*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_4*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_5*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_6*"
add_region_find_insts "region_gemm_engine_west" "find -insts *i_engine_top_2d.gen_row_7*"

# East side region for rows 8-15
create_region "region_gemm_engine_east" "300 160 330 260" -snap fabric_clusters -type soft
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_8*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_9*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_10*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_11*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_12*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_13*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_14*"
add_region_find_insts "region_gemm_engine_east" "find -insts *i_engine_top_2d.gen_row_15*"

